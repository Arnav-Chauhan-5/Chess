datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum GameStatus {
  IN_PROGRESS
  WHITE_WON
  BLACK_WON
  DRAW
  ABORTED
}

enum EndReason {
  CHECKMATE
  RESIGNATION
  TIMEOUT
  DRAW_AGREEMENT
  STALEMATE
  THREEFOLD_REPETITION
  FIFTY_MOVE_RULE
  INSUFFICIENT_MATERIAL
  ABANDONED
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String?                       // null for OAuth-only users
  avatarUrl     String?
  rating        Int            @default(1200)
  createdAt     DateTime       @default(now())
  oauthAccounts OAuthAccount[]
  gamesAsWhite  Game[]         @relation("GamesAsWhite")
  gamesAsBlack  Game[]         @relation("GamesAsBlack")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  provider          String   // "google" | "facebook" | "github" | "microsoft"
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Game {
  id              String     @id @default(uuid())
  whiteId         String?                        // null when opponent is AI
  blackId         String?
  whitePlayer     User?      @relation("GamesAsWhite", fields: [whiteId], references: [id])
  blackPlayer     User?      @relation("GamesAsBlack", fields: [blackId], references: [id])
  vsAI            Boolean    @default(false)
  isCasual        Boolean    @default(true)
  aiDifficulty    Int?                            // Stockfish skill level, if vsAI
  pgn             String     @default("")
  status          GameStatus @default(IN_PROGRESS)
  endReason       EndReason?
  whiteRatingDelta Int?
  blackRatingDelta Int?
  timeControlSec  Int?                            // e.g. 300 for 5+0
  incrementSec    Int?       @default(0)
  whiteTimeLeftMs Int?
  blackTimeLeftMs Int?
  moves           Move[]
  createdAt       DateTime   @default(now())
  endedAt         DateTime?
}

model Move {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])
  moveNumber  Int
  san         String
  fenAfter    String
  playerColor String   // "white" | "black"
  createdAt   DateTime @default(now())
}
