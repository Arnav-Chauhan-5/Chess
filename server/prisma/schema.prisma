datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum GameStatus {
  IN_PROGRESS
  WHITE_WON
  BLACK_WON
  DRAW
  ABORTED
}

enum EndReason {
  CHECKMATE
  RESIGNATION
  TIMEOUT
  DRAW_AGREEMENT
  STALEMATE
  THREEFOLD_REPETITION
  FIFTY_MOVE_RULE
  INSUFFICIENT_MATERIAL
  ABANDONED
}

enum CosmeticType {
  BOARD_THEME
  PIECE_SET
}

model User {
  id                   String         @id @default(uuid())
  username             String         @unique
  email                String         @unique
  passwordHash         String?                       // null for OAuth-only users
  avatarUrl            String?
  rating               Int            @default(1200)
  bestRating           Int?           @default(1200)
  bestRatingDate       DateTime?
  coinsBalance         Int            @default(0)   // Chess Coins earned from daily challenges etc.
  dailyChallengeStreak Int            @default(0)   // Consecutive days completing the daily challenge
  showOnlineStatus     Boolean        @default(true)
  // Currently equipped cosmetics (null = app default)
  equippedBoardThemeId String?
  equippedPieceSetId   String?
  createdAt            DateTime       @default(now())
  oauthAccounts        OAuthAccount[]
  gamesAsWhite         Game[]         @relation("GamesAsWhite")
  gamesAsBlack         Game[]         @relation("GamesAsBlack")
  friendsSent          Friendship[]   @relation("FriendRequester")
  friendsReceived      Friendship[]   @relation("FriendAddressee")
  dailyChallenges      DailyChallenge[]
  notifications        Notification[]
  ownedCosmetics       UserCosmetic[]
  equippedBoardTheme   CosmeticItem?  @relation("EquippedBoardTheme", fields: [equippedBoardThemeId], references: [id])
  equippedPieceSet     CosmeticItem?  @relation("EquippedPieceSet", fields: [equippedPieceSetId], references: [id])
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id])
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id])
  status      String   @default("PENDING") // PENDING, ACCEPTED
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // FRIEND_REQUEST | CHALLENGE | GAME_INVITE | DRAW_OFFER
  message   String
  data      Json?    // e.g. { fromUserId, fromUsername, gameId, friendshipId }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OAuthAccount {
  id                String   @id @default(uuid())
  provider          String   // "google" | "facebook" | "github" | "microsoft"
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Game {
  id              String     @id @default(uuid())
  whiteId         String?                        // null when opponent is AI
  blackId         String?
  whitePlayer     User?      @relation("GamesAsWhite", fields: [whiteId], references: [id])
  blackPlayer     User?      @relation("GamesAsBlack", fields: [blackId], references: [id])
  vsAI            Boolean    @default(false)
  isCasual        Boolean    @default(true)
  aiDifficulty    Int?                            // Stockfish skill level, if vsAI
  pgn             String     @default("")
  status          GameStatus @default(IN_PROGRESS)
  endReason       EndReason?
  whiteRatingDelta Int?
  blackRatingDelta Int?
  whiteRatingAtGame Int?
  blackRatingAtGame Int?
  aiPersonaName   String?
  timeControlSec  Int?                            // e.g. 300 for 5+0
  incrementSec    Int?       @default(0)
  whiteTimeLeftMs Int?
  blackTimeLeftMs Int?
  moves           Move[]
  createdAt       DateTime   @default(now())
  endedAt         DateTime?
}

model Move {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])
  moveNumber  Int
  san         String
  fenAfter    String
  playerColor String   // "white" | "black"
  createdAt   DateTime @default(now())
}

model DailyChallenge {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  // UTC midnight of the day this challenge covers, e.g. 2026-08-27T00:00:00.000Z
  challengeDate DateTime
  completedAt   DateTime? // set when the qualifying game finishes; null = not yet done
  rewarded      Boolean   @default(false) // true once coins have been awarded for this day

  @@unique([userId, challengeDate])
}

// ── Cosmetics ─────────────────────────────────────────────────────────────────

// The catalog of all purchasable (and free) cosmetic items
model CosmeticItem {
  id               String        @id @default(uuid())
  type             CosmeticType
  name             String
  description      String        @default("")
  coinCost         Int           @default(0)
  isDefault        Boolean       @default(false) // Free starter — all new users get it automatically
  // Board theme fields (null for PIECE_SET items)
  lightSquareColor String?
  darkSquareColor  String?
  highlightColor   String?       // Optional accent for selected-square overlay (client hint)
  // Piece set fields (null for BOARD_THEME items)
  pieceSetKey      String?       // Client-side key mapping to a react-chessboard piece style
  createdAt        DateTime      @default(now())

  ownedByUsers     UserCosmetic[]
  equippedAsBoard  User[]        @relation("EquippedBoardTheme")
  equippedAsPieces User[]        @relation("EquippedPieceSet")
}

// Junction table: which users own which cosmetic items
model UserCosmetic {
  id             String       @id @default(uuid())
  userId         String
  cosmeticItemId String
  user           User         @relation(fields: [userId], references: [id])
  cosmeticItem   CosmeticItem @relation(fields: [cosmeticItemId], references: [id])
  purchasedAt    DateTime     @default(now())
  coinsPaid      Int          @default(0) // 0 for default/gifted items

  @@unique([userId, cosmeticItemId])
}
